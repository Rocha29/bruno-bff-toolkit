# ===== AUTENTICAÇÃO STS =====
STS_URL=https://sts.sandbox.local
STS_CLIENT_ID=seu-client-id-aqui
STS_CLIENT_SECRET=seu-client-secret-aqui
STS_SCOPE=api

# ===== ENDPOINTS =====
GATEWAY_URL=http://localhost:9090
PAGAMENTOS_API=http://localhost:8081
BFF_URL=http://localhost:8080

# ===== TIMEOUTS E RETRIES =====
REQUEST_TIMEOUT=30000
RETRY_MAX=3
RETRY_DELAY=1000

# ===== AMBIENTE =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# ===== TRIBUTOS (Específico do domínio) =====
TRIBUTO_RETRY_MAX=2
TRIBUTO_VALIDATION_TIMEOUT=5000

# ===== PIX (Específico do domínio) =====
PIX_CHUNK_SIZE=10000
PIX_MAX_RECIPIENTS=100

# ===== DDA (Específico do domínio) =====
DDA_MANDATO_VALID_DAYS=180
DDA_MIN_AMOUNT=0.01
